    },
    "이 여행에 한 번 기록하면 그때 쓴 금액으로 단추가 생깁니다": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse einmal auf dieser Reise, dann entstehen Tasten mit deinen Beträgen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record once on this trip and buttons appear with the amounts you used"
