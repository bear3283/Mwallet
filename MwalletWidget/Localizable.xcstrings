    "눌러서 바로 기록": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen und sofort erfassen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to record"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca y apunta al momento"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca y registra al momento"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toucher pour saisir aussitôt"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca e registra subito"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップしてすぐ記録"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e anote na hora"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按即刻记录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下立即記錄"
          }
        }
      }
    },
    "눌러서 바로 기록하거나, 프리셋으로 빠르게 담습니다.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen und sofort erfassen, oder mit einer Vorlage schnell hinzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to record, or use a preset to add one fast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca y apunta al momento, o usa un ajuste guardado para ir más rápido."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca y registra al momento, o usa un ajuste guardado para ir más rápido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez pour saisir aussitôt, ou utilisez un préréglage pour aller vite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca e registra subito, oppure usa un preset per fare in fretta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップしてすぐ記録、またはプリセットで手早く追加できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e anote na hora, ou use um atalho salvo para ir mais rápido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按即刻记录，或用预设快速添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下立即記錄，或用預設組合快速新增。"
          }
        }
      }
    },
    "눌러서 바로 담기 · 앱을 열면 기록에 들어갑니다": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen zum Hinzufügen · landet im Kassenbuch, wenn du die App öffnest"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to add · it lands in your ledger when you open the app"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para añadir · entra en el cuaderno al abrir la app"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para agregar · entra en la libreta al abrir la app"
