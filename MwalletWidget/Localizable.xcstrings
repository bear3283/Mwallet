    "눌러서 바로 기록": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to record"
          }
        }
      }
    },
    "눌러서 바로 기록하거나, 프리셋으로 빠르게 담습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to record, or use a preset to add one fast."
          }
        }
      }
    },
    "눌러서 바로 담기 · 앱을 열면 기록에 들어갑니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to add · it lands in your ledger when you open the app"
          }
        }
      }
    },
    "되돌리기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo"
