        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toucher pour ajouter · cela arrive dans le carnet à l’ouverture de l’app"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca per aggiungere · finisce nel registro quando apri l’app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップして追加 · アプリを開くと家計簿に入ります"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para adicionar · entra no caderno quando você abrir o app"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
