        }
      }
    },
    "예결산 탭을 한 번 열면\n결산이 표시됩니다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Budget tab once\nand your totals appear here"
          }
        }
      }
    },
    "예결산 탭을 한 번 열면\n예산이 표시됩니다": {
