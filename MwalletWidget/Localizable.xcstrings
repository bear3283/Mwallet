    "영수증이 아직 없는 지출 수를 보고 바로 등록합니다.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh, wie viele Ausgaben noch einen Beleg brauchen, und füge ihn gleich hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See how many expenses still need a receipt, and add one right away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira cuántos gastos siguen sin recibo y añádelo al momento."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira cuántos gastos siguen sin recibo y agrégalo al momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez combien de dépenses attendent un reçu, et ajoutez-le aussitôt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedi quante spese aspettano ancora una ricevuta e aggiungila subito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシートがまだない支出の数を見て、すぐ登録できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja quantos gastos ainda esperam um recibo e adicione na hora."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看还没有收据的支出笔数，并立即登记。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看還沒有收據的支出筆數，並立即登錄。"
          }
        }
      }
    },
    "예결산 탭을 한 번 열면\n결산이 표시됩니다": {
      "extractionState": "manual",
      "localizations": {
