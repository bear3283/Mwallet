    "예산 대비 집행과 카테고리 내역을 봅니다.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh die Ausgaben gegen das Budget und die Aufteilung nach Kategorien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See spending against budget, and the breakdown by category."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira el gasto frente al presupuesto y el desglose por categoría."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira el gasto frente al presupuesto y el desglose por categoría."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
