    "저장소가 CloudKit 없이 열렸습니다. iCloud 권한(entitlement)과 로그인 상태를 확인하세요.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Speicher wurde ohne CloudKit geöffnet. Prüfe die iCloud-Berechtigung (Entitlement) und ob du angemeldet bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The store opened without CloudKit. Check the iCloud entitlement and that you're signed in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El almacén se abrió sin CloudKit. Comprueba el permiso de iCloud (entitlement) y que has iniciado sesión."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El almacén se abrió sin CloudKit. Revisa el permiso de iCloud (entitlement) y que hayas iniciado sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stockage s’est ouvert sans CloudKit. Vérifiez l’autorisation iCloud (entitlement) et que vous êtes connecté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’archivio si è aperto senza CloudKit. Controlla l’autorizzazione iCloud (entitlement) e di aver eseguito l’accesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CloudKit なしでストアが開きました。iCloud の権限（entitlement）とサインイン状態を確認してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O armazenamento abriu sem o CloudKit. Confira a permissão do iCloud (entitlement) e se você entrou na conta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储已在没有 CloudKit 的情况下打开。请检查 iCloud 权限（entitlement）和登录状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存空間已在沒有 CloudKit 的情況下開啟。請檢查 iCloud 權限（entitlement）和登入狀態。"
          }
        }
      }
    },
