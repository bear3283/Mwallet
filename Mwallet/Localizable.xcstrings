    "아직 위치가 남은 지출이 없습니다.\n기록할 때 위치를 함께 남기면 들른 순서가 지도에 그려집니다.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Ausgabe mit Ort.\nGib beim Erfassen einen Ort an, dann werden deine Stationen auf der Karte gezeichnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No expenses with a location yet.\nAdd a location when you record and your stops will be drawn on the map."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay gastos con lugar.\nAñade un lugar al apuntar y tus paradas se dibujarán en el mapa."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay gastos con lugar.\nAgrega un lugar al registrar y tus paradas se dibujarán en el mapa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune dépense avec un lieu.\nIndiquez un lieu à la saisie et vos étapes seront tracées sur la carte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna spesa con un luogo.\nAggiungi un luogo quando registri e le tue tappe verranno disegnate sulla mappa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "場所の残った支出がまだありません。\n記録するときに場所も残すと、立ち寄った順が地図に描かれます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há gastos com lugar.\nAnote um lugar junto e suas paradas serão desenhadas no mapa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有留下位置的支出。\n记录时一并留下位置，走过的顺序就会画在地图上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有留下位置的支出。\n記錄時一併留下位置，走過的順序就會畫在地圖上。"
          }
        }
      }
    },
