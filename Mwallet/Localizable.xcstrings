    "지출 당일이 아닌 오늘 기준 환율이 적용됩니다.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gilt der heutige Kurs, nicht der vom Tag der Ausgabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today’s rate is used, not the rate on the day you spent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica el cambio de hoy, no el del día del gasto."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica el tipo de cambio de hoy, no el del día del gasto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est le taux du jour qui s’applique, pas celui du jour de la dépense."
          }
        },
        "it": {
