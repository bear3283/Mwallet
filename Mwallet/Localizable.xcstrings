    "현재 생성된 여행이 없어요.\n여행을 생성할까요?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast noch keine Reise.\nEine anlegen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have no trips yet.\nCreate one?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no tienes ningún viaje.\n¿Creamos uno?"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no tienes ningún viaje.\n¿Creamos uno?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
