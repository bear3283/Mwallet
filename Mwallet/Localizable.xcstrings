    "예결산 그래프에서 이 분류를 가리키는 색입니다. 어두운 화면용 색은 자동으로 맞춥니다.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Farbe markiert diese Kategorie im Budget-Diagramm. Die Farbe für den dunklen Modus wird automatisch abgeleitet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The color that marks this category on the budget chart. The dark-mode color is derived automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El color señala esta categoría en el gráfico. El color para el modo oscuro se calcula solo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El color señala esta categoría en la gráfica. El color para el modo oscuro se calcula solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La couleur repère cette catégorie sur le graphique. La couleur du mode sombre est calculée automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il colore segna questa categoria nel grafico. Il colore per la modalità scura si ricava da solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "決算グラフでこの分類を示す色です。ダークモード用の色は自動で合わせます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cor marca esta categoria no gráfico. A cor do modo escuro é calculada sozinha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "决算图表中标示这个分类的颜色。深色模式的颜色会自动调整。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "決算圖表中標示這個分類的顏色。深色模式的顏色會自動調整。"
          }
        }
      }
    },
