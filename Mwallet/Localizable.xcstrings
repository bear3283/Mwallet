    "이 기기에서 %@ 음성 인식을 쓸 수 없습니다. 직접 기록으로 남겨 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Spracherkennung ist auf diesem Gerät nicht verfügbar. Trag es von Hand ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ speech recognition isn't available on this device. Enter it manually instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento de voz en %@ no está disponible en este dispositivo. Escríbelo a mano."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento de voz en %@ no está disponible en este dispositivo. Escríbelo a mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance vocale en %@ n’est pas disponible sur cet appareil. Saisissez-le à la main."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il riconoscimento vocale in %@ non è disponibile su questo dispositivo. Inseriscilo a mano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末では %@ の音声認識を使えません。手入力で記録してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O reconhecimento de fala em %@ não está disponível neste aparelho. Digite à mão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备无法使用 %@ 语音识别。请手动记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置無法使用 %@ 語音辨識。請手動記錄。"
          }
        }
      }
    },
    "이 동작은 되돌릴 수 없습니다.\niCloud 로 연결된 다른 기기에서도 함께 지워집니다.\n\n남겨야 할 기록이 있다면 영수증 탭에서 CSV 로 먼저 내보내세요.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das lässt sich nicht rückgängig machen.\nAuch auf deinen anderen iCloud-Geräten wird es gelöscht.\n\nWenn etwas bleiben soll, exportiere vorher im Tab „Belege“ eine CSV."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This can’t be undone.\nIt is erased on your other iCloud devices too.\n\nIf there’s anything to keep, export a CSV from the Receipts tab first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede deshacer.\nTambién se borra en tus otros dispositivos con iCloud.\n\nSi hay algo que quieras conservar, exporta antes un CSV desde la pestaña Recibos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede deshacer.\nTambién se elimina en tus otros dispositivos con iCloud.\n\nSi hay algo que quieras conservar, exporta antes un CSV desde la pestaña Recibos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est irréversible.\nCela s’efface aussi sur vos autres appareils iCloud.\n\nS’il y a quelque chose à garder, exportez d’abord un CSV depuis l’onglet Reçus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non si può annullare.\nViene cancellato anche sugli altri dispositivi iCloud.\n\nSe c’è qualcosa da tenere, esporta prima un CSV dalla scheda Ricevute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作は元に戻せません。\niCloud でつながった他の端末からも一緒に消えます。\n\n残しておきたい記録があれば、レシートタブから CSV で先に書き出してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não dá para desfazer.\nTambém é apagado nos seus outros aparelhos com iCloud.\n\nSe houver algo a guardar, exporte antes um CSV pela aba Recibos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作无法撤销。\n通过 iCloud 连接的其他设备上也会一并清除。\n\n如果有需要保留的记录，请先从收据标签导出 CSV。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此動作無法復原。\n透過 iCloud 連接的其他裝置上也會一併清除。\n\n如果有需要保留的記錄，請先從收據標籤匯出 CSV。"
          }
        }
      }
    },
    "이 언어는 아직 말하기로 받아 적지 못합니다. 직접 기록을 눌러 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Sprache lässt sich noch nicht diktieren. Tippe auf „Von Hand erfassen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech isn't supported in this language yet. Tap Enter manually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este idioma aún no se puede dictar. Toca «Escribir a mano»."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Este idioma aún no se puede dictar. Toca «Escribir a mano»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette langue n’est pas encore prise en charge à la voix. Touchez « Saisir à la main »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa lingua non è ancora supportata a voce. Tocca «Inserisci a mano»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この言語はまだ音声で書き取れません。「手で記録」を押してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este idioma ainda não pode ser ditado. Toque em “Digitar à mão”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个语言还不能用语音记录。请点「手动记录」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個語言還不能用語音記錄。請點「手動記錄」。"
          }
        }
      }
    },
