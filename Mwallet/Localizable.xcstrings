    "영수증 %lld건을 표로 내보냅니다. 통화가 섞여 있어도 현지 금액과 적용 환율, 원화 환산액이 각각 들어갑니다.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportiert %lld Belege als Tabelle. Auch bei gemischten Währungen bekommen der Betrag vor Ort, der verwendete Kurs und der umgerechnete Betrag je eine Spalte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exports %lld receipts as a table. Even with mixed currencies, the local amount, the rate used and the converted amount each get a column."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta %lld recibos como tabla. Aunque haya monedas mezcladas, el importe local, el cambio aplicado y la conversión llevan cada uno su columna."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta %lld recibos como tabla. Aunque haya monedas mezcladas, el monto local, el tipo de cambio aplicado y la conversión llevan cada uno su columna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte %lld reçus sous forme de tableau. Même avec des devises mélangées, le montant local, le taux appliqué et la conversion ont chacun leur colonne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esporta %lld ricevute come tabella. Anche con valute miste, l’importo locale, il tasso usato e la conversione hanno ciascuno una colonna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシート %lld 件を表で書き出します。通貨が混ざっていても、現地金額・適用レート・ウォン換算額がそれぞれ入ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta %lld recibos como tabela. Mesmo com moedas misturadas, o valor local, a taxa aplicada e a conversão ficam cada um em uma coluna."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把 %lld 笔收据导出成表格。即使货币混杂，当地金额、所用汇率和韩元换算额也会各占一栏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把 %lld 筆收據匯出成表格。即使幣別混雜，當地金額、所用匯率和韓元換算額也會各占一欄。"
          }
        }
      }
    },
