    "색은 예결산 그래프에서 이 분류를 가리킵니다. 붙박이 분류와 이미 쓰인 분류는 지우는 대신 목록에서 감춥니다.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Farbe markiert diese Kategorie im Budget-Diagramm. Feste und bereits benutzte Kategorien werden ausgeblendet statt gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The color marks this category on the budget chart. Built-in categories and ones already in use are hidden rather than deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El color señala esta categoría en el gráfico. Las integradas y las ya usadas se ocultan en vez de borrarse."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El color señala esta categoría en la gráfica. Las integradas y las que ya se usan se ocultan en vez de eliminarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La couleur repère cette catégorie sur le graphique. Les catégories intégrées et déjà utilisées sont masquées plutôt que supprimées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il colore segna questa categoria nel grafico. Le categorie integrate e quelle già usate vengono nascoste anziché eliminate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "色は決算グラフでこの分類を示します。組み込みの分類とすでに使われている分類は、削除せず一覧から隠します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cor marca esta categoria no gráfico. As categorias internas e as que já estão em uso ficam ocultas em vez de excluídas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "颜色用于在决算图表中标示这个分类。内置分类和已被使用的分类会从列表中隐藏，而不是删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顏色用來在決算圖表中標示這個分類。內建分類和已被使用的分類會從清單中隱藏，而不是刪除。"
          }
        }
      }
    },
