    "지출이 생기면 바로 남겨두세요.\n오프라인에서도 저장됩니다.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib Ausgaben gleich auf.\nEs speichert auch offline."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jot spending down as it happens.\nIt saves offline too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta los gastos según ocurren.\nSe guarda incluso sin conexión."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra los gastos según ocurren.\nSe guarda incluso sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notez les dépenses au fil de l’eau.\nCela s’enregistre même hors ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annota le spese appena capitano.\nSi salva anche offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支出が出たらすぐ書き留めてください。\nオフラインでも保存されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anote os gastos assim que acontecerem.\nSalva mesmo sem internet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有支出就随手记下。\n离线也能保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有支出就隨手記下。\n離線也能儲存。"
          }
        }
      }
    },
