    "아직 나눌 지출이 없습니다.\n기록할 때 함께 쓴 사람을 고르면 여기에 나뉩니다.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts zu teilen.\nWähle beim Erfassen, wer mitbezahlt hat, dann wird es hier aufgeteilt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to split yet.\nPick who shared an expense when you record it and it will be split here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay nada que repartir.\nElige quién compartió un gasto al apuntarlo y se repartirá aquí."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay nada que dividir.\nElige quién compartió un gasto al registrarlo y se dividirá aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à partager pour l’instant.\nChoisissez qui a partagé une dépense au moment de la saisie, et le partage apparaîtra ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente da dividere per ora.\nScegli chi ha condiviso una spesa quando la registri e comparirà qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ分けるものがありません。\n記録するときに一緒に使った人を選ぶと、ここで分かれます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há nada para dividir.\nEscolha quem dividiu um gasto na hora de anotar e ele aparece dividido aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有要分摊的支出。\n记录时选择一同消费的人，就会在这里分开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有要分攤的支出。\n記錄時選擇一同消費的人，就會在這裡分開。"
          }
        }
      }
    },
