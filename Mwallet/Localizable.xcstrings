    "여행·지출·예산·영수증 사진이 모두 지워집니다.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reisen, Ausgaben, Budgets und Belegfotos werden alle gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trips, expenses, budgets and receipt photos will all be erased."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borrarán todos los viajes, gastos, presupuestos y fotos de recibos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán todos los viajes, gastos, presupuestos y fotos de recibos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyages, dépenses, budgets et photos de reçus seront tous effacés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viaggi, spese, budget e foto delle ricevute verranno cancellati tutti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行・支出・予算・レシートの写真がすべて消えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Viagens, gastos, orçamentos e fotos de recibos serão todos apagados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "行程、支出、预算和收据照片都会被清除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "行程、支出、預算和收據照片都會被清除。"
          }
        }
      }
    },
    "여행·지출·예산이 모두 지워집니다. 되돌릴 수 없습니다.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reisen, Ausgaben und Budgets werden alle gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trips, expenses and budgets will all be erased. This can’t be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borrarán todos los viajes, gastos y presupuestos. No se puede deshacer."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán todos los viajes, gastos y presupuestos. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyages, dépenses et budgets seront tous effacés. C’est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viaggi, spese e budget verranno cancellati tutti. Non si può annullare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行・支出・予算がすべて消えます。元には戻せません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Viagens, gastos e orçamentos serão todos apagados. Não dá para desfazer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "行程、支出和预算都会被清除。无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "行程、支出和預算都會被清除。無法復原。"
          }
        }
      }
    },
