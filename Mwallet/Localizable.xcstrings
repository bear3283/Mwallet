    "함께 쓴 사람이 적히지 않은 %lld건(%@)은 나누지 못했습니다": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei %1$lld Posten (%2$@) war niemand eingetragen, sie ließen sich nicht aufteilen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld items (%2$@) had nobody recorded, so they couldn’t be split"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld apuntes (%2$@) no tenían a nadie anotado, así que no se pudieron repartir"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld registros (%2$@) no tenían a nadie anotado, así que no se pudieron dividir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld éléments (%2$@) n’avaient personne d’enregistré, impossible de les partager"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld voci (%2$@) non avevano nessuno registrato, non è stato possibile dividerle"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一緒に使った人が書かれていない %1$lld 件（%2$@）は分けられませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "함께 쓴 사람이 적히지 않은 %1$lld건(%2$@)은 나누지 못했습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld lançamentos (%2$@) não tinham ninguém anotado, então não deu para dividir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %1$lld 笔（%2$@）没有记下一同消费的人，无法分摊"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %1$lld 筆（%2$@）沒有記下一同消費的人，無法分攤"
          }
        }
      }
    },
