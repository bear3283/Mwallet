    "첨부한 사진도 함께 삭제되며 되돌릴 수 없습니다.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angehängte Fotos werden mitgelöscht, und das lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attached photos are deleted too, and this can’t be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos adjuntas se borran también, y no se puede deshacer."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos adjuntas se eliminan también, y no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos jointes sont supprimées aussi, et c’est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche le foto allegate vengono eliminate, e non si può annullare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "添えた写真も一緒に削除され、元には戻せません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos anexadas também são excluídas, e não dá para desfazer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附上的照片也会一并删除，且无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "附上的照片也會一併刪除，且無法復原。"
