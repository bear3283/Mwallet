    "아직 집행 내역이 없어요. 지출을 기록하면 비중이 채워집니다.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts ausgegeben. Erfasse eine Ausgabe, dann füllen sich die Anteile."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing spent yet. Record an expense and the shares will fill in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no has gastado nada. Apunta un gasto y los pesos se rellenarán."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no has gastado nada. Registra un gasto y las proporciones se llenarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de dépensé. Saisissez une dépense et les parts se rempliront."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente speso. Registra una spesa e le quote si riempiranno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ支出がありません。記録すると割合が埋まります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada gasto ainda. Anote um gasto e as participações se preenchem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有支出。记录一笔，占比就会填上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有支出。記錄一筆，占比就會填上。"
          }
        }
      }
    },
