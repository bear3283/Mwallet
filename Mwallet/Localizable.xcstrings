    "그래프에서 두 조각이 붙어 있으면 한 덩어리로 보일 수 있습니다. 그대로 저장해도 됩니다.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liegen zwei Stücke im Diagramm nebeneinander, wirken sie leicht wie eines. Du kannst es trotzdem so speichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If two slices sit next to each other on the chart, they may read as one. You can save it as is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si dos porciones quedan juntas en el gráfico, pueden parecer una sola. Puedes guardarlo así."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Si dos porciones quedan juntas en la gráfica, pueden verse como una sola. Puedes guardarlo así."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si deux parts se touchent sur le graphique, elles peuvent sembler n’en former qu’une. Vous pouvez enregistrer tel quel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se due fette si toccano nel grafico, possono sembrare una sola. Puoi salvare così com’è."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グラフで二つの区画が隣り合うと、ひとかたまりに見えることがあります。このまま保存しても構いません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se duas fatias ficarem lado a lado no gráfico, podem parecer uma só. Você pode salvar assim mesmo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图表上相邻的两块可能看起来像一块。也可以就这样保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖表上相鄰的兩塊可能看起來像一塊。也可以就這樣儲存。"
          }
        }
      }
    },
