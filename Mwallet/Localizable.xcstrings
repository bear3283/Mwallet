    "오른쪽 위 + 로 여행을 만들면\n지출이 그 여행에 모입니다.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe oben rechts auf +, um eine Reise anzulegen,\ndann sammeln sich deine Ausgaben dort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap + at the top right to create a trip,\nand your spending will collect there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca + arriba a la derecha para crear un viaje\ny tus gastos se juntarán ahí."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca + arriba a la derecha para crear un viaje\ny tus gastos se juntarán ahí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez + en haut à droite pour créer un voyage,\net vos dépenses s’y rassembleront."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca + in alto a destra per creare un viaggio,\ne le tue spese si raccoglieranno lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上の + で旅行を作ると、\n支出がその旅行に集まります。"
