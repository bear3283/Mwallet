# 이 세션 동안 손으로 되풀이하던 것들을 레인으로 옮겼다.
#
#   bundle exec fastlane test         단위 테스트 200건
#   bundle exec fastlane screenshots  네 탭·여행 상세를 찍어 파일로 꺼낸다
#   bundle exec fastlane lint         SwiftLint 위반만 모아 본다
#   bundle exec fastlane metadata     App Store 정보만 올린다 (빌드는 안 건드린다)
#
# 세 레인 모두 계정 정보가 필요 없다. 시뮬레이터에서만 돈다.

default_platform(:ios)

# App Store Connect 에 말을 걸 때 쓰는 열쇠.
#
# 세 값은 fastlane/.env 에서 읽는다. 개인키(.p8)는 저장소 밖에 두고 경로만
# 넘긴다 — 한 번만 내려받을 수 있는 파일이고, 들어오면 계정 전체를 만질 수
# 있어 저장소에 두면 안 된다.
#
# 세팅은 fastlane/.env.example 을 복사해 채운다.
def connect_api_key
  missing = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH].reject { |name| ENV[name].to_s.strip != "" }
  unless missing.empty?
    UI.user_error!("fastlane/.env 에 #{missing.join(', ')} 가 없습니다. " \
                   "fastlane/.env.example 을 복사해 채우세요.")
  end

  path = File.expand_path(ENV["ASC_KEY_PATH"])
  UI.user_error!("개인키를 찾지 못했습니다: #{path}") unless File.exist?(path)

  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_filepath: path,
    # 키를 오래 살려 두지 않는다. 올리는 데 걸리는 시간이면 넉넉하다.
    duration: 1200,
    in_house: false
  )
end

# 프로젝트에 매번 넘기는 값들. 한 곳에 모아 둔다.
PROJECT = "Mwallet.xcodeproj"
SCHEME = "Mwallet"
DEVICE = "iPhone 17"

platform :ios do

  desc "단위 테스트를 돌린다 (화면 테스트는 뺀다)"
  lane :test do
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      devices: [DEVICE],
      # 화면 테스트는 시뮬레이터를 띄우고 눌러 보느라 1분 넘게 걸린다.
      # 빨리 돌려 보는 것이 목적이라 여기서는 뺀다.
      skip_testing: ["MwalletUITests"],
      # CI 도, 이 레인도 서명 없이 돈다.
      xcargs: "CODE_SIGNING_ALLOWED=NO",
      result_bundle: true,
      output_directory: "fastlane/test_output"
    )
  end

  desc "화면을 찍어 fastlane/screenshots 로 꺼낸다"
  lane :screenshots do
    # 화면 테스트는 서명이 있어야 한다. CloudKit 이 엔타이틀먼트 없이 뜨면
    # 앱이 뜨자마자 죽어 아무것도 찍히지 않는다.
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      devices: [DEVICE],
      only_testing: ["MwalletUITests/ScreenshotTests"],
      result_bundle: true,
      output_directory: "fastlane/test_output"
    )
    export_screenshots
  end

  desc "App Store Connect 열쇠가 통하는지 본다 (읽기만 한다)"
  lane :check_key do
    api_key = connect_api_key
    Spaceship::ConnectAPI.auth(**api_key.slice(:key_id, :issuer_id, :key, :duration, :in_house))

    apps = Spaceship::ConnectAPI::App.all
    if apps.empty?
      UI.important("열쇠는 통하는데 볼 수 있는 앱이 없습니다. 키의 권한(역할)을 확인하세요.")
    else
      UI.success("열쇠가 통합니다. 볼 수 있는 앱 #{apps.count}개:")
      apps.each { |app| UI.message("  #{app.name}  (#{app.bundle_id})") }
    end

    mine = apps.find { |app| app.bundle_id == "com.bear3745.Mwallet.app" }
    if mine
      UI.success("Mwallet 을 찾았습니다: #{mine.name}")
    else
      UI.important("이 열쇠로는 com.bear3745.Mwallet.app 이 보이지 않습니다. " \
                   "App Store Connect 에 앱을 먼저 만들어야 올릴 수 있습니다.")
    end
  end

  desc "TestFlight 에 올린다"
  lane :beta do
    api_key = connect_api_key
    ensure_app_exists(api_key)

    # 올리기 전에 한 번 더 돌린다. 깨진 것을 올려 놓고 알아채면 늦다.
    test
    lint

    increment_build_number(
      xcodeproj: PROJECT,
      build_number: latest_testflight_build_number(api_key: api_key, initial_build_number: 0) + 1
    )

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      export_method: "app-store",
      # 프로비저닝 프로파일이 없으면 열쇠로 만들어 온다.
      xcargs: "-allowProvisioningUpdates"
    )

    upload_to_testflight(
      api_key: api_key,
      # 심사 대기 없이 내부 테스터에게만 먼저 간다.
      skip_waiting_for_build_processing: true
    )
  end

  desc "App Store 정보만 올린다 (빌드는 건드리지 않는다)"
  #
  # 스토어에 적히는 글은 fastlane/metadata 아래에 파일로 둔다. 웹에서 고치면
  # 무엇을 언제 왜 바꿨는지가 남지 않고, 심사에서 되돌려 받았을 때 이전 문구로
  # 되돌릴 방법도 없다. 저장소에 두면 diff 로 보이고 되돌릴 수 있다.
  #
  # 빌드는 올리지 않는다. 글만 고치려고 앱을 다시 빌드할 이유가 없고,
  # 스크린샷도 손대지 않는다(fastlane screenshots 로 따로 찍는다).
  lane :metadata do
    api_key = connect_api_key
    ensure_app_exists(api_key)

    privacy = File.read("metadata/ko/privacy_url.txt").strip
    if privacy.include?("example.notion.site")
      UI.user_error!("metadata/ko/privacy_url.txt 가 아직 예시 주소입니다. " \
                     "노션에서 '웹에 게시' 한 뒤 나오는 공개 주소로 바꿔 주세요.")
    end

    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      # 올리기 전에 무엇이 바뀌는지 보여 주고 묻는다.
      force: false,
      precheck_include_in_app_purchases: false
    )
  end

  desc "SwiftLint 위반만 모아 본다"
  lane :lint do
    # SwiftLint 는 빌드 플러그인으로 함께 도므로 빌드 로그에서 걸러 낸다.
    output = sh(
      "cd .. && xcodebuild build -project #{PROJECT} -scheme #{SCHEME} " \
      "-destination 'platform=iOS Simulator,name=#{DEVICE}' " \
      "CODE_SIGNING_ALLOWED=NO 2>&1 | grep -E 'warning: [A-Z].*\\(' || true",
      log: false
    )
    if output.strip.empty?
      UI.success("SwiftLint 위반 없음")
    else
      UI.important(output)
      UI.user_error!("SwiftLint 위반이 있습니다")
    end
  end
end

# 올릴 앱이 App Store Connect 에 있는지 먼저 본다.
#
# 없는 채로 올리면 한참 빌드한 뒤에야 알아보기 어려운 오류로 끝난다.
# 앱을 만드는 것은 여기서 하지 않는다 — 이름·SKU·번들 ID 를 정하는 일이고
# 한 번 정하면 되돌리기 번거로워 사람이 대시보드에서 할 몫이다.
def ensure_app_exists(api_key)
  Spaceship::ConnectAPI.auth(**api_key.slice(:key_id, :issuer_id, :key, :duration, :in_house))
  bundle_id = "com.bear3745.Mwallet.app"

  return if Spaceship::ConnectAPI::App.all.any? { |app| app.bundle_id == bundle_id }

  UI.user_error!(
    "App Store Connect 에 #{bundle_id} 가 없습니다.\n" \
    "먼저 https://appstoreconnect.apple.com 에서 앱을 만드세요.\n" \
    "(이름·SKU·번들 ID 를 정하는 일이라 여기서 대신 하지 않습니다)"
  )
end

# 화면 테스트는 XCTAttachment 로 그림을 남긴다. 결과 묶음 안에 들어 있어
# 그대로는 볼 수 없으므로 파일로 꺼내 이름을 붙여 준다.
#
# 세션 내내 이 작업을 손으로 되풀이했다 — xcresulttool 로 꺼내고, 매니페스트를
# 읽어 사람이 붙인 이름을 찾고, UUID 파일명을 그 이름으로 바꾸는 일이다.
#
# 경로는 모두 절대 경로로 만든다. fastlane 은 레인을 fastlane 폴더 안에서
# 돌리는데 run_tests 의 output_directory 는 프로젝트 뿌리를 기준으로 잡아,
# 상대 경로로 적으면 둘이 어긋난다.
def export_screenshots
  require "json"
  require "fileutils"

  root = File.expand_path("..", __dir__)
  bundle = Dir[File.join(root, "fastlane/test_output/*.xcresult")].max_by { |path| File.mtime(path) }
  return UI.important("결과 묶음을 찾지 못했습니다") if bundle.nil?

  raw = File.join(root, "fastlane/test_output/attachments")
  FileUtils.rm_rf(raw)
  sh("xcrun xcresulttool export attachments --path '#{bundle}' --output-path '#{raw}'", log: false)

  manifest = File.join(raw, "manifest.json")
  return UI.important("매니페스트가 없습니다") unless File.exist?(manifest)

  out = File.join(root, "fastlane/screenshots")
  FileUtils.rm_rf(out)
  FileUtils.mkdir_p(out)

  count = 0
  walk(JSON.parse(File.read(manifest))) do |item|
    name = item["suggestedHumanReadableName"] || item["exportedFileName"]
    # 화면 테스트가 붙인 이름은 '01-기록' 처럼 숫자로 시작한다.
    # 그 밖의 것(시스템이 남긴 스냅숏·녹화)은 건너뛴다.
    next unless name =~ /\A\d/
    source = File.join(raw, item["exportedFileName"])
    next unless File.exist?(source)
    # 이름 뒤에 '_0_<UUID>' 가 붙어 온다. 같은 이름이 여러 번 찍힐 때를
    # 가르려는 꼬리인데, 우리는 한 번씩만 찍으므로 떼어 낸다.
    clean = name.sub(/\.png\z/, "").sub(/_\d+_[0-9A-F-]{36}\z/i, "")
    FileUtils.cp(source, File.join(out, "#{clean}.png"))
    count += 1
  end

  UI.success("화면 #{count}장을 fastlane/screenshots 에 꺼냈습니다")
end

# 매니페스트의 짜임이 판마다 달라, 파일 이름을 든 마디를 찾아 훑는다.
def walk(node, &block)
  case node
  when Hash
    block.call(node) if node.key?("exportedFileName")
    node.each_value { |value| walk(value, &block) }
  when Array
    node.each { |value| walk(value, &block) }
  end
end
