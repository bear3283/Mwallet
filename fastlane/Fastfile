# 이 세션 동안 손으로 되풀이하던 것들을 레인으로 옮겼다.
#
#   bundle exec fastlane test         단위 테스트 200건
#   bundle exec fastlane screenshots  네 탭·여행 상세를 찍어 파일로 꺼낸다
#   bundle exec fastlane lint         SwiftLint 위반만 모아 본다
#   bundle exec fastlane metadata     App Store 정보만 올린다 (빌드는 안 건드린다)
#
# 세 레인 모두 계정 정보가 필요 없다. 시뮬레이터에서만 돈다.

default_platform(:ios)

# App Store Connect 에 말을 걸 때 쓰는 열쇠.
#
# 세 값은 fastlane/.env 에서 읽는다. 개인키(.p8)는 저장소 밖에 두고 경로만
# 넘긴다 — 한 번만 내려받을 수 있는 파일이고, 들어오면 계정 전체를 만질 수
# 있어 저장소에 두면 안 된다.
#
# 세팅은 fastlane/.env.example 을 복사해 채운다.
def connect_api_key
  missing = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH].reject { |name| ENV[name].to_s.strip != "" }
  unless missing.empty?
    UI.user_error!("fastlane/.env 에 #{missing.join(', ')} 가 없습니다. " \
                   "fastlane/.env.example 을 복사해 채우세요.")
  end

  path = File.expand_path(ENV["ASC_KEY_PATH"])
  UI.user_error!("개인키를 찾지 못했습니다: #{path}") unless File.exist?(path)

  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_filepath: path,
    # 키를 오래 살려 두지 않는다. 올리는 데 걸리는 시간이면 넉넉하다.
    duration: 1200,
    in_house: false
  )
end

# 프로젝트에 매번 넘기는 값들. 한 곳에 모아 둔다.
PROJECT = "Mwallet.xcodeproj"
SCHEME = "Mwallet"
DEVICE = "iPhone 17"
# 화면을 찍을 때 언어마다 새로 깔려고 쓴다.
APP_ID = "com.bear3745.Mwallet.app"

platform :ios do

  desc "단위 테스트를 돌린다 (화면 테스트는 뺀다)"
  lane :test do
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      devices: [DEVICE],
      # 화면 테스트는 시뮬레이터를 띄우고 눌러 보느라 1분 넘게 걸린다.
      # 빨리 돌려 보는 것이 목적이라 여기서는 뺀다.
      skip_testing: ["MwalletUITests"],
      # CI 도, 이 레인도 서명 없이 돈다.
      xcargs: "CODE_SIGNING_ALLOWED=NO",
      result_bundle: true,
      output_directory: "fastlane/test_output"
    )
  end

  desc "화면을 찍어 fastlane/screenshots 로 꺼낸다"
  lane :screenshots do
    # 화면 테스트는 서명이 있어야 한다. CloudKit 이 엔타이틀먼트 없이 뜨면
    # 앱이 뜨자마자 죽어 아무것도 찍히지 않는다.
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      devices: [DEVICE],
      only_testing: ["MwalletUITests/ScreenshotTests"],
      result_bundle: true,
      output_directory: "fastlane/test_output"
    )
    export_screenshots
  end

  # 스토어 페이지는 열한 언어인데 화면은 한국어 한 벌뿐이었다.
  # 앱이 열한 언어로 뜨게 된 지금은 언어마다 찍을 수 있다.
  #
  # 폴더 이름은 fastlane/metadata 의 것을 그대로 쓴다. deliver 가 그 짝을 보고
  # 올리므로 하나라도 어긋나면 그 언어만 조용히 빠진다.
  STORE_LOCALES = {
    "ko"      => { language: "ko",      locale: "ko_KR" },
    "en-US"   => { language: "en",      locale: "en_US" },
    "ja"      => { language: "ja",      locale: "ja_JP" },
    "zh-Hans" => { language: "zh-Hans", locale: "zh_CN" },
    "zh-Hant" => { language: "zh-Hant", locale: "zh_TW" },
    "de-DE"   => { language: "de",      locale: "de_DE" },
    "fr-FR"   => { language: "fr",      locale: "fr_FR" },
    "it"      => { language: "it",      locale: "it_IT" },
    "es-ES"   => { language: "es",      locale: "es_ES" },
    "es-MX"   => { language: "es-MX",   locale: "es_MX" },
    "pt-BR"   => { language: "pt-BR",   locale: "pt_BR" }
  }.freeze

  desc "스토어용 화면을 열한 언어로 찍는다"
  lane :store_screenshots do |options|
    only = options[:locale]
    targets = only ? STORE_LOCALES.select { |key, _| key == only } : STORE_LOCALES
    UI.user_error!("모르는 언어입니다: #{only}") if targets.empty?

    # 기기를 이름이 아니라 UDID 로 못 박는다.
    #
    # 이름으로 주면 xcodebuild 가 같은 기종의 다른 기기를 골라 갈 수 있다.
    # 실제로 그랬다 — '시뮬2' 라는 기기가 iPhone 17 기종이라 그리로 갔고,
    # 지우기는 이름이 'iPhone 17' 인 기기에 했다. 그래서 아무리 지워도
    # 옛 예시 데이터가 그대로 나왔다.
    udid = simulator_udid(DEVICE)
    UI.user_error!("'#{DEVICE}' 시뮬레이터를 찾지 못했습니다") if udid.nil?
    UI.message("기기 #{DEVICE} (#{udid})")

    out = File.join(File.expand_path("..", __dir__), "fastlane/screenshots")
    FileUtils.rm_rf(out) unless only
    FileUtils.mkdir_p(out)

    targets.each_with_index do |(store_locale, setting), index|
      UI.header("#{store_locale}  (#{index + 1}/#{targets.count})")

      # 언어마다 기기를 비운다.
      #
      # 화면을 채우는 예시 데이터(DebugSampleData)는 첫 실행 때 한 번 저장되고
      # 그대로 남는다. 지우지 않으면 열한 번을 돌려도 처음 돈 언어의 이름이
      # 계속 나온다 — 독일어 화면에 한국어 여행 이름이 박히는 것이 그 탓이다.
      #
      # 여행 이름은 사용자가 적는 값이라 화면에서 옮기지 않는다. 저장될 때
      # 그 언어로 적히게 하는 것이 옳고, 그러려면 새로 깔아야 한다.
      #
      # uninstall 로는 모자란다. 장부가 App Group 으로 옮겨 간 뒤로는(#42)
      # 앱을 지워도 그 컨테이너가 남아 옛 이름이 그대로 살아 있다.
      # erase 가 기기를 통째로 비우는 유일한 길이다.
      sh("xcrun simctl shutdown #{udid} > /dev/null 2>&1 || true", log: false)
      sh("xcrun simctl erase #{udid}", log: false)

      run_tests(
        project: PROJECT,
        scheme: SCHEME,
        destination: ["platform=iOS Simulator,id=#{udid}"],
        only_testing: ["MwalletUITests/StoreScreenshotTests"],
        result_bundle: true,
        output_directory: "fastlane/test_output",
        # 언어는 xcodebuild 가 정한다. 환경변수로 넘기면 빌드 설정이 되어
        # 테스트 프로세스까지 닿지 않는다.
        # -parallel-testing-enabled NO 가 있어야 한다. 없으면 xcodebuild 가
        # 시뮬레이터를 복제해 그 위에서 돌리는데, 위에서 지운 것은 원본이라
        # 복제본에는 옛 예시 데이터가 그대로 살아 있다. 그러면 언어만 바뀌고
        # 여행 이름은 처음 돈 언어의 것이 계속 나온다.
        xcargs: "-testLanguage #{setting[:language]} -testRegion #{setting[:locale]} " \
                "-parallel-testing-enabled NO"
      )

      moved = export_screenshots(File.join(out, store_locale))
      UI.user_error!("#{store_locale} 화면을 한 장도 못 찍었습니다") if moved.zero?
    end

    UI.success("열한 언어 화면을 fastlane/screenshots 아래 언어별로 꺼냈습니다")
  end

  desc "App Store Connect 열쇠가 통하는지 본다 (읽기만 한다)"
  lane :check_key do
    api_key = connect_api_key
    Spaceship::ConnectAPI.auth(**api_key.slice(:key_id, :issuer_id, :key, :duration, :in_house))

    apps = Spaceship::ConnectAPI::App.all
    if apps.empty?
      UI.important("열쇠는 통하는데 볼 수 있는 앱이 없습니다. 키의 권한(역할)을 확인하세요.")
    else
      UI.success("열쇠가 통합니다. 볼 수 있는 앱 #{apps.count}개:")
      apps.each { |app| UI.message("  #{app.name}  (#{app.bundle_id})") }
    end

    mine = apps.find { |app| app.bundle_id == "com.bear3745.Mwallet.app" }
    if mine
      UI.success("Mwallet 을 찾았습니다: #{mine.name}")
    else
      UI.important("이 열쇠로는 com.bear3745.Mwallet.app 이 보이지 않습니다. " \
                   "App Store Connect 에 앱을 먼저 만들어야 올릴 수 있습니다.")
    end
  end

  desc "TestFlight 에 올린다"
  lane :beta do
    api_key = connect_api_key
    ensure_app_exists(api_key)

    # 올리기 전에 한 번 더 돌린다. 깨진 것을 올려 놓고 알아채면 늦다.
    test
    lint

    increment_build_number(
      xcodeproj: PROJECT,
      build_number: latest_testflight_build_number(api_key: api_key, initial_build_number: 0) + 1
    )

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      export_method: "app-store",
      # 프로비저닝 프로파일이 없으면 열쇠로 만들어 온다.
      xcargs: "-allowProvisioningUpdates"
    )

    upload_to_testflight(
      api_key: api_key,
      # 심사 대기 없이 내부 테스터에게만 먼저 간다.
      skip_waiting_for_build_processing: true
    )
  end

  desc "App Store 정보만 올린다 (빌드는 건드리지 않는다)"
  #
  # 스토어에 적히는 글은 fastlane/metadata 아래에 파일로 둔다. 웹에서 고치면
  # 무엇을 언제 왜 바꿨는지가 남지 않고, 심사에서 되돌려 받았을 때 이전 문구로
  # 되돌릴 방법도 없다. 저장소에 두면 diff 로 보이고 되돌릴 수 있다.
  #
  # 빌드는 올리지 않는다. 글만 고치려고 앱을 다시 빌드할 이유가 없고,
  # 스크린샷도 손대지 않는다(fastlane screenshots 로 따로 찍는다).
  lane :metadata do |options|
    api_key = connect_api_key
    ensure_app_exists(api_key)

    privacy = File.read("metadata/ko/privacy_url.txt").strip
    if privacy.include?("example.notion.site")
      UI.user_error!("metadata/ko/privacy_url.txt 가 아직 예시 주소입니다. " \
                     "노션에서 '웹에 게시' 한 뒤 나오는 공개 주소로 바꿔 주세요.")
    end

    # 지원 URL 은 http(s) 만 받는다. mailto: 를 넣으면 언어마다 하나씩
    # 'Support URL you entered is invalid' 로 되돌아온다.
    support = File.read("metadata/ko/support_url.txt").strip
    unless support.start_with?("http")
      UI.user_error!("지원 URL 은 http(s) 주소여야 합니다(지금: #{support}). " \
                     "메일 주소는 App Store Connect 가 받지 않습니다.")
    end

    # 심사 연락처는 전화번호가 없으면 통째로 거절당한다. 없으면 그 부분만 빼고
    # 나머지를 올린다 — 목록 문구까지 못 올릴 이유는 없다.
    review = "metadata/review_information"
    phone = File.join(review, "phone_number.txt")
    unless File.exist?(phone) && !File.read(phone).strip.empty?
      UI.important("심사 연락처에 전화번호가 없어 그 부분은 올리지 않습니다. " \
                   "#{phone} 에 번호를 넣으면 함께 올라갑니다.")
      skip_review_information = true
    end

    # 전화번호가 없으면 심사 연락처 폴더를 잠시 비켜 둔다.
    held = nil
    if skip_review_information && Dir.exist?(review)
      # metadata 안에 두면 deliver 가 언어 폴더로 오해한다. 바깥으로 옮긴다.
      held = "review_information.hold"
      FileUtils.mv(review, held)
    end

    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      # 올리기 전에 무엇이 바뀌는지 보여 주고 묻는다.
      # 물어볼 수 없는 자리(비대화형)에서는 force:true 로 건너뛴다.
      force: options[:force] == true || options[:force] == "true",
      precheck_include_in_app_purchases: false
    )
  ensure
    FileUtils.mv(held, review) if held && Dir.exist?(held)
  end

  desc "SwiftLint 위반만 모아 본다"
  lane :lint do
    # SwiftLint 는 빌드 플러그인으로 함께 도므로 빌드 로그에서 걸러 낸다.
    output = sh(
      "cd .. && xcodebuild build -project #{PROJECT} -scheme #{SCHEME} " \
      "-destination 'platform=iOS Simulator,name=#{DEVICE}' " \
      "CODE_SIGNING_ALLOWED=NO 2>&1 | grep -E 'warning: [A-Z].*\\(' || true",
      log: false
    )
    if output.strip.empty?
      UI.success("SwiftLint 위반 없음")
    else
      UI.important(output)
      UI.user_error!("SwiftLint 위반이 있습니다")
    end
  end
end

# 올릴 앱이 App Store Connect 에 있는지 먼저 본다.
#
# 없는 채로 올리면 한참 빌드한 뒤에야 알아보기 어려운 오류로 끝난다.
# 앱을 만드는 것은 여기서 하지 않는다 — 이름·SKU·번들 ID 를 정하는 일이고
# 한 번 정하면 되돌리기 번거로워 사람이 대시보드에서 할 몫이다.
def ensure_app_exists(api_key)
  Spaceship::ConnectAPI.auth(**api_key.slice(:key_id, :issuer_id, :key, :duration, :in_house))
  bundle_id = "com.bear3745.Mwallet.app"

  return if Spaceship::ConnectAPI::App.all.any? { |app| app.bundle_id == bundle_id }

  UI.user_error!(
    "App Store Connect 에 #{bundle_id} 가 없습니다.\n" \
    "먼저 https://appstoreconnect.apple.com 에서 앱을 만드세요.\n" \
    "(이름·SKU·번들 ID 를 정하는 일이라 여기서 대신 하지 않습니다)"
  )
end

# 화면 테스트는 XCTAttachment 로 그림을 남긴다. 결과 묶음 안에 들어 있어
# 그대로는 볼 수 없으므로 파일로 꺼내 이름을 붙여 준다.
#
# 세션 내내 이 작업을 손으로 되풀이했다 — xcresulttool 로 꺼내고, 매니페스트를
# 읽어 사람이 붙인 이름을 찾고, UUID 파일명을 그 이름으로 바꾸는 일이다.
#
# 경로는 모두 절대 경로로 만든다. fastlane 은 레인을 fastlane 폴더 안에서
# 돌리는데 run_tests 의 output_directory 는 프로젝트 뿌리를 기준으로 잡아,
# 상대 경로로 적으면 둘이 어긋난다.
# 이름으로 시뮬레이터의 UDID 를 찾는다.
#
# 같은 기종의 기기가 여럿일 수 있어(사용자가 이름을 바꿔 만든 것 포함),
# 이름으로만 주면 xcodebuild 가 어느 것을 고를지 우리가 정할 수 없다.
def simulator_udid(name)
  require "json"
  listing = JSON.parse(`xcrun simctl list devices --json`)
  listing["devices"].values.flatten.find do |device|
    device["name"] == name && device["isAvailable"]
  end&.dig("udid")
end

# destination 을 주면 그리로 꺼내고, 안 주면 예전처럼 fastlane/screenshots 로 간다.
# 언어별로 찍을 때는 벌마다 제 폴더가 있어야 해서 자리를 받는다.
def export_screenshots(destination = nil)
  require "json"
  require "fileutils"

  root = File.expand_path("..", __dir__)
  bundle = Dir[File.join(root, "fastlane/test_output/*.xcresult")].max_by { |path| File.mtime(path) }
  if bundle.nil?
    UI.important("결과 묶음을 찾지 못했습니다")
    return 0
  end

  raw = File.join(root, "fastlane/test_output/attachments")
  FileUtils.rm_rf(raw)
  sh("xcrun xcresulttool export attachments --path '#{bundle}' --output-path '#{raw}'", log: false)

  manifest = File.join(raw, "manifest.json")
  unless File.exist?(manifest)
    UI.important("매니페스트가 없습니다")
    return 0
  end

  out = destination || File.join(root, "fastlane/screenshots")
  FileUtils.rm_rf(out)
  FileUtils.mkdir_p(out)

  count = 0
  walk(JSON.parse(File.read(manifest))) do |item|
    name = item["suggestedHumanReadableName"] || item["exportedFileName"]
    # 화면 테스트가 붙인 이름은 '01-기록' 처럼 숫자로 시작한다.
    # 그 밖의 것(시스템이 남긴 스냅숏·녹화)은 건너뛴다.
    next unless name =~ /\A\d/
    source = File.join(raw, item["exportedFileName"])
    next unless File.exist?(source)
    # 이름 뒤에 '_0_<UUID>' 가 붙어 온다. 같은 이름이 여러 번 찍힐 때를
    # 가르려는 꼬리인데, 우리는 한 번씩만 찍으므로 떼어 낸다.
    clean = name.sub(/\.png\z/, "").sub(/_\d+_[0-9A-F-]{36}\z/i, "")
    FileUtils.cp(source, File.join(out, "#{clean}.png"))
    count += 1
  end

  UI.success("화면 #{count}장을 #{out.sub(root + '/', '')} 에 꺼냈습니다")
  count
end

# 매니페스트의 짜임이 판마다 달라, 파일 이름을 든 마디를 찾아 훑는다.
def walk(node, &block)
  case node
  when Hash
    block.call(node) if node.key?("exportedFileName")
    node.each_value { |value| walk(value, &block) }
  when Array
    node.each { |value| walk(value, &block) }
  end
end
