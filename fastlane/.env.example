# App Store Connect API 키
#
# 이 파일을 fastlane/.env 로 복사한 뒤 본인의 값을 채우세요.
# fastlane 이 레인을 돌릴 때 자동으로 읽습니다.
# fastlane/.env 는 .gitignore 에 의해 커밋되지 않습니다.
#
# 세 값은 App Store Connect → 사용자 및 접근 → 통합 → 팀 키 에서 얻습니다.
#   https://appstoreconnect.apple.com/access/integrations/api
#
# ⚠️ .p8 파일은 한 번만 내려받을 수 있고 다시 받을 수 없습니다.
#    저장소 밖(예: iCloud, 암호 관리자)에 두고 여기에는 경로만 적으세요.

ASC_KEY_ID=YOUR_KEY_ID_HERE
ASC_ISSUER_ID=YOUR_ISSUER_ID_HERE
ASC_KEY_PATH=/absolute/path/to/AuthKey_YOUR_KEY_ID.p8
